        <mxCell id="oracle" value="&lt;b style=&quot;font-size:19px&quot;&gt;Oracle остаётся source of record&lt;/b&gt;&lt;br&gt;&lt;br&gt;OLTP / PL/SQL / staging / retry&lt;br&gt;Все scoped writers учитываются&lt;br&gt;.NET, admin и batch сохраняются&lt;br&gt;Нет обратной записи из проекции" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;fontSize=16;fontColor=#203247;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;" vertex="1" parent="legacy">
