        <mxCell id="oldread" value="&lt;b style=&quot;font-size:19px&quot;&gt;Legacy Support read / actions&lt;/b&gt;&lt;br&gt;&lt;br&gt;Старое чтение для fallback&lt;br&gt;Операционные команды остаются здесь" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;fontSize=16;fontColor=#203247;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;" vertex="1" parent="legacy">
